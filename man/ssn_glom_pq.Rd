df <- subset_taxa_pq(data_fungi_mini, taxa_sums(data_fungi_mini) > 5000)
phyloseq::ntaxa(df)

pq_nsc <- ssn_glom_pq(df, id = 0.9, verbose = TRUE)
phyloseq::ntaxa(pq_nsc)

